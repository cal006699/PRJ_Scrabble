<Window x:Class="Scrabble2Joueurs.UI.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Scrabble2Joueurs.UI"
        mc:Ignorable="d"
        Title="Historique des Parties" Height="450" Width="700" WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="📜 Historique des Parties de Scrabble" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <!-- La grille pour afficher l'historique -->
        <DataGrid x:Name="dgHistorique" Grid.Row="1" AutoGenerateColumns="True" IsReadOnly="True" 
                  Background="White" BorderBrush="#FF6892B3" BorderThickness="2" Margin="0,0,0,15"/>

        <!-- Bouton pour lancer une nouvelle partie -->
        <Button x:Name="btnNouvellePartie" Content="Lancer une nouvelle partie" Grid.Row="2" 
                Width="200" Height="35" FontSize="14" Background="#FF6892B3" Foreground="White" 
                HorizontalAlignment="Center" Click="btnNouvellePartie_Click"/>
    </Grid>
</Window>